# Environment Variables — Deltablue Jet Air
# Copy this file to .env.local and fill in the values

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=deltablue-jet-air.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=deltablue-jet-air
VITE_FIREBASE_STORAGE_BUCKET=deltablue-jet-air.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini AI — used by vite.config.ts define shim (not prefixed with VITE_)
GEMINI_API_KEY=

# Stripe Payments (set to 'true' for real Stripe; 'false' for simulated)
VITE_STRIPE_ENABLED=false

# Notifications (set to 'true' for real email/SMS via Cloud Functions)
VITE_NOTIFICATIONS_LIVE=false

# Firebase Emulators (set to 'true' to use local emulators)
VITE_USE_EMULATORS=

# SSO Configuration
VITE_SSO_CALLBACK_URL=https://admin.deltablue.com/api/auth/sso/saml/callback

# External URLs
VITE_STATUS_PAGE_URL=https://status.deltablue.to

