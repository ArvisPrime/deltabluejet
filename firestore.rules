rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isOpsStaff() {
      return isAuthenticated() && request.auth.token.role in ['super_admin', 'ops_manager', 'crew_sched', 'cs_agent'];
    }

    function isAgent() {
      return isAuthenticated() && request.auth.token.role in ['super_admin', 'cs_agent'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isOpsStaff();
      allow create: if (isAuthenticated() && request.auth.uid == userId)
                    || isAdmin();
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));
      allow delete: if isAdmin();
    }

    // ─── Customers ────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isOpsStaff();
      allow create: if isAuthenticated();
      allow update: if isOwner(customerId) || isAdmin();
      allow delete: if isAdmin();

      // Saved Travelers sub-collection
      match /savedTravelers/{travelerId} {
        allow read, write: if isOwner(customerId);
      }
    }

    // ─── Loyalty ──────────────────────────────────────────
    match /loyalty/{userId} {
      allow read: if isOwner(userId) || isOpsStaff();
      allow create: if false;  // Only Cloud Functions (loyalty.ts triggers)
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['currentPoints', 'lifetimePoints', 'tier', 'lifetimeFlights', 'lifetimeSpend']));
      allow delete: if isAdmin();
    }

    // ─── Flights ───────────────────────────────────────────
    match /flights/{flightId} {
      allow read: if true;  // Public flight info
      allow write: if isOpsStaff();
    }

    // ─── Aircraft ──────────────────────────────────────────
    match /aircraft/{aircraftId} {
      allow read: if isAuthenticated();
      allow write: if isOpsStaff();
    }

    // ─── Routes ────────────────────────────────────────────
    match /routes/{routeId} {
      allow read: if true;
      allow write: if isOpsStaff();
    }

    // ─── Destinations ──────────────────────────────────────
    match /destinations/{destId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Bookings ──────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isOpsStaff()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOpsStaff()
                    || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      // Passengers sub-collection
      match /passengers/{passengerId} {
        allow read: if isOpsStaff()
                    || (isAuthenticated() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid);
        allow write: if isOpsStaff()
                     || (isAuthenticated() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid);
      }
    }

    // ─── Payments ──────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isOpsStaff();
      allow write: if false;  // Only Cloud Functions can write payments
    }

    // ─── Payment Reconciliation ─────────────────────────────
    match /payment_reconciliation/{docId} {
      allow read: if isOpsStaff();
      allow write: if false;  // Only Cloud Functions
    }

    // ─── Check-ins ─────────────────────────────────────────
    match /checkins/{checkinId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOpsStaff();
    }

    // ─── Seat Maps ─────────────────────────────────────────
    match /seatMaps/{seatMapId} {
      allow read: if true;
      allow write: if isOpsStaff();
    }

    // ─── Sessions ──────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if isOpsStaff();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── Active Sessions (Session Monitor) ─────────────────
    match /active_sessions/{sessionId} {
      allow read: if isOpsStaff();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || isAdmin();
    }

    // ─── Security Policies ────────────────────────────────
    match /security_policies/{policyId} {
      allow read: if isOpsStaff();
      allow write: if isOpsStaff();
    }

    // ─── CMS Pages ─────────────────────────────────────────
    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── CMS Config (header, footer, menus, seat maps, triggers) ─
    match /cms_config/{configId} {
      allow read: if true;
      allow write: if isOpsStaff();
    }

    // ─── SEO Config ────────────────────────────────────────────
    match /seo_config/{configId} {
      allow read: if true;
      allow write: if isOpsStaff();
    }

    // ─── SEO Audit Log ─────────────────────────────────────────
    match /seo_audit/{logId} {
      allow read: if isOpsStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── Schedules ─────────────────────────────────────────
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isOpsStaff();
    }

    // ─── Email Templates ───────────────────────────────────
    match /email_templates/{templateId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── SMS Templates ─────────────────────────────────────
    match /sms_templates/{templateId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── Notification Logs ─────────────────────────────────
    match /notification_logs/{logId} {
      allow read: if isOpsStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── Audit Logs ────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isOpsStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── Session Audit Log ─────────────────────────────────
    match /session_audit_log/{logId} {
      allow read: if isOpsStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── Admin Config (MFA, SSO, Password Policy) ──────────
    match /admin_config/{configId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── Loyalty Tiers ─────────────────────────────────────
    match /loyalty_tiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Loyalty Rewards ───────────────────────────────────
    match /loyalty_rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Loyalty Partners ──────────────────────────────────
    match /loyalty_partners/{partnerId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── Loyalty Redemptions ───────────────────────────────
    match /loyalty_redemptions/{redemptionId} {
      allow read: if isOpsStaff()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── Ancillary Products (Baggage, Meals, Lounges) ──────
    match /ancillary_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Ancillary Orders ──────────────────────────────────
    match /ancillary_orders/{orderId} {
      allow read: if isOpsStaff()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isOpsStaff()
                    || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Crew Members ──────────────────────────────────────
    match /crew_members/{crewId} {
      allow read: if isOpsStaff();
      allow create, update: if isOpsStaff();
      allow delete: if isAdmin();
    }

    // ─── Crew Assignments ──────────────────────────────────
    match /crew_assignments/{assignId} {
      allow read: if isOpsStaff();
      allow create, update: if isOpsStaff();
      allow delete: if isOpsStaff();
    }

    // ─── Crew Schedules ────────────────────────────────────
    match /crew_schedules/{schedId} {
      allow read: if isOpsStaff();
      allow write: if isOpsStaff();
    }

    // ─── Airports ──────────────────────────────────────────
    match /airports/{airportId} {
      allow read: if true;
      allow write: if isOpsStaff();
    }

    // ─── Experiments (A/B Testing) ─────────────────────────
    match /experiments/{expId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── Sales Daily Aggregates ────────────────────────────
    match /sales_daily/{docId} {
      allow read: if isOpsStaff();
      allow write: if false;  // Only Cloud Functions write aggregates
    }

    // ─── Disruptions ───────────────────────────────────────
    match /disruptions/{disruptionId} {
      allow read: if isOpsStaff();
      allow write: if isOpsStaff();
    }

    // ─── Trigger Configs (Operational Triggers) ────────────
    match /trigger_configs/{configId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── Rate Limits (Cloud Functions only) ─────────────────
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // ─── WebAuthn Credentials (Security Keys) ─────────────
    match /webauthn_credentials/{credId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;  // Only Cloud Functions can write
    }

    // ─── WebAuthn Challenges (Ephemeral) ──────────────────
    match /webauthn_challenges/{challengeId} {
      allow read, write: if false;  // Only Cloud Functions can read/write
    }

    // ─── App Config (Dashboard Access Control) ──────────────
    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Custom Roles ──────────────────────────────────────
    match /roles/{roleId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── Group Policies ────────────────────────────────────
    match /groupPolicies/{policyId} {
      allow read: if isOpsStaff();
      allow write: if isAdmin();
    }

    // ─── Fare Rules ────────────────────────────────────────
    match /fare_rules/{ruleId} {
      allow read: if true;           // Public — passengers view refund policies
      allow write: if isAdmin();
    }

    // ─── Vouchers / Credits ────────────────────────────────
    match /vouchers/{voucherId} {
      allow read: if isOpsStaff()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();    // Status changes via Cloud Functions or admin
      allow delete: if isAdmin();
    }

    // ─── Visa Requirements ─────────────────────────────────
    match /visa_requirements/{reqId} {
      allow read: if true;           // Public reference data
      allow write: if isAdmin();
    }

    // ─── Baggage Claims ────────────────────────────────────
    match /baggage_claims/{claimId} {
      allow read: if isOpsStaff()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOpsStaff();   // Status changes by ops
      allow delete: if isAdmin();
    }
  }
}
